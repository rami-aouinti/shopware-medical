<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="custom/plugins/MedicalInventory/tests/Integration/dal-bootstrap.php"
    colors="true"
    cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="MedicalInventory DAL Integration">
            <directory>custom/plugins/MedicalInventory/tests/Integration/Dal</directory>
        </testsuite>
    </testsuites>
</phpunit>
