{
  "name": "medical/mock-san6",
  "description": "Independent SAN6-inspired ERP simulator for the MedicalERPConnector Shopware plugin.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.4",
    "doctrine/doctrine-bundle": "^2.18",
    "doctrine/orm": "^3.5",
    "symfony/console": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/yaml": "7.4.*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "extra": {
    "runtime": {
      "dotenv_path": ".env"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "sort-packages": true
  }
}
