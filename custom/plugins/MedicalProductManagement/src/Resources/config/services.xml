<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="MedicalProductManagement\Infrastructure\Persistence\Shopware\ProductDocument\ProductDocumentDefinition" class="MedicalProductManagement\Infrastructure\Persistence\Shopware\ProductDocument\ProductDocumentDefinition" public="true">
            <tag name="shopware.entity.definition" entity="medical_product_document"/>
        </service>
        <service id="MedicalProductManagement\Infrastructure\Shopware\ProductDefinitionExtension" class="MedicalProductManagement\Infrastructure\Shopware\ProductDefinitionExtension">
            <tag name="shopware.entity.extension"/>
        </service>

        <service id="MedicalProductManagement\Domain\ProductCatalog\Validation\ProductCustomFieldValidator"/>
        <service id="MedicalProductManagement\Domain\ProductDocuments\Policy\ProductDocumentPrivacyPolicy"/>

        <service id="MedicalProductManagement\Infrastructure\ProductCatalog\ShopwareProductCustomFieldInstaller">
            <argument type="service" id="custom_field_set.repository"/>
        </service>
        <service id="MedicalProductManagement\Domain\ProductCatalog\Port\ProductCustomFieldInstallerInterface" alias="MedicalProductManagement\Infrastructure\ProductCatalog\ShopwareProductCustomFieldInstaller"/>
        <service id="MedicalProductManagement\Application\ProductCatalog\Install\InstallProductCustomFieldsHandler">
            <argument type="service" id="MedicalProductManagement\Domain\ProductCatalog\Port\ProductCustomFieldInstallerInterface"/>
        </service>

        <service id="MedicalProductManagement\Transport\Event\ProductCustomFieldValidationSubscriber">
            <argument type="service" id="MedicalProductManagement\Domain\ProductCatalog\Validation\ProductCustomFieldValidator"/>
            <tag name="kernel.event_subscriber"/>
        </service>
        <service id="MedicalProductManagement\Transport\Console\InstallProductCustomFieldsCommand">
            <argument type="service" id="MedicalProductManagement\Application\ProductCatalog\Install\InstallProductCustomFieldsHandler"/>
            <tag name="console.command"/>
        </service>
        <service id="MedicalProductManagement\Transport\Http\Controller\ProductDocumentController">
            <argument type="service" id="medical_product_document.repository"/>
            <argument type="service" id="media.repository"/>
            <argument type="service" id="MedicalProductManagement\Domain\ProductDocuments\Policy\ProductDocumentPrivacyPolicy"/>
            <argument type="service" id="Shopware\Core\Content\Media\File\DownloadResponseGenerator"/>
            <tag name="controller.service_arguments"/>
        </service>
    </services>
</container>